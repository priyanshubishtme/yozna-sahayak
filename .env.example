# Yojana Sahayak Environment Configuration Template
# Copy this file to .env and adjust the values as needed. NEVER commit .env to version control.

# Application Core
APP_NAME="Yojana Sahayak"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
TIMEZONE=Asia/Kolkata
DEFAULT_LANGUAGE=hi

# Security & CORS
# For development, allow Vite's local dev server
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ADMIN_SESSION_SECRET=change-this-insecure-secret-key-in-production-use-openssl-rand-hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword

# Persistence & Storage
DATABASE_URL=sqlite+aiosqlite:///./data/yojana_sahayak.db
DATABASE_SYNC_URL=sqlite:///./data/yojana_sahayak.db
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/indexes/chroma

# LLM Provider (Groq API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_SECONDS=45

# Embedding & Retrieval
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
DENSE_K=20
SPARSE_K=20
RRF_K=60
FINAL_K=5

# Scraper & Scheduler
SCRAPER_ENABLED=true
SCRAPER_USER_AGENT="YojanaSahayakResearchBot/1.0 (contact: admin@yojanasahayak.local)"
SCRAPER_DEFAULT_CRON="0 3 * * *"
SCRAPER_MAX_CONCURRENT_SOURCES=2
SCRAPER_REQUEST_INTERVAL_SECONDS=5
SCHEDULER_PROCESS_MODE=dedicated_single_instance

# Notifications & Reminders (Optional)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yojanasahayak.local

# Frontend Public Env (Vite)
VITE_API_BASE_URL=http://localhost:8000
